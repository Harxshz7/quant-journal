{
  "manifest_version": 3,
  "name": "Quant Journal Logger",
  "version": "0.1.0",
  "description": "Log TradingView trades straight into your Quant Journal.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://localhost:8080/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Quant Journal Logger"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://tradingview.com/*"
      ],
      "js": [
        "src/content/tradingview.js"
      ],
      "run_at": "document_idle"
    }
  ]
}